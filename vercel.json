{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/publish.ts": {
      "includeFiles": "lib/**"
    },
    "api/insights/sync.ts": {
      "includeFiles": "lib/**"
    },
    "api/insights/post.ts": {
      "includeFiles": "lib/**"
    },
    "api/insights/account.ts": {
      "includeFiles": "lib/**"
    },
    "api/insights/import-posts.ts": {
      "includeFiles": "lib/**"
    },
    "api/insights/best-hours.ts": {
      "includeFiles": "lib/**"
    }
  },
  "crons": [
    {
      "path": "/api/insights/sync?secret=${CRON_SECRET}",
      "schedule": "0 8 * * *"
    }
  ]
}
