{
  "crons": [
    {
      "path": "/api/publish?secret=CRON_SECRET",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/publish.ts": {
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
